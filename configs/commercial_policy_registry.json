    "CONDITIONAL_COMMERCIAL": {
      "description": "Models permitted for commercial use only when specific contractual conditions and component audits are satisfied.",
      "models": {
        "ltx": {
          "name": "LTX-2.3 / LTX-2.5",
          "aliases": ["ltx", "ltx23", "ltx-2.3", "ltx25", "ltx-2.5", "ltx25cq", "dearchive", "oumoumad", "official"],
          "license": "LTX-Community-License",
          "source_repo": "https://huggingface.co/Lightricks/LTX-Video",
          "conditions": {
            "company_revenue_under_10m_usd": {
              "type": "boolean",
              "required": true,
              "description": "Company annual gross revenue must be under $10,000,000 USD."
            },
            "ic_lora_audited": {
              "type": "boolean",
              "required": true,
              "description": "Explicit audit verification for IC-LoRA weights."
            },
            "gemma_encoder_audited": {
              "type": "boolean",
              "required": true,
              "description": "Explicit audit verification for Gemma-3 text encoder weights."
            }
          },
          "component_types": ["checkpoint", "lora", "text_encoder"],
          "audited_hashes": []
        },
        "deepexemplar": {
          "name": "Deep Exemplar",
          "aliases": ["deepexemplar", "deep-exemplar"],
          "license": "MIT (Code) / Conditional Weights",
          "source_repo": "https://github.com/zhangmozhe/Deep-Exemplar-based-Video-Colorization",
          "conditions": {
            "weight_vgg19_audited": {
              "type": "boolean",
              "required": true,
              "description": "Explicit audit flag confirming VGG19 and colorization weights are cleared."
            }
          },
          "component_types": ["checkpoint", "weights"],
          "audited_hashes": []
        }
      }
